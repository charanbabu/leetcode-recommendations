# App
APP_NAME=LeetCode AI Agent
ENVIRONMENT=development
BASE_URL=http://localhost:8000

# Database (SQLite default — no setup needed)
DATABASE_URL=sqlite+aiosqlite:///data/leetcode.db

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Defaults (optional)
DEFAULT_LEETCODE_USERNAME=

# LeetCode Premium (for company frequency data)
# Get these from browser: DevTools > Application > Cookies > leetcode.com
LEETCODE_SESSION_COOKIE=
LEETCODE_CSRFTOKEN=

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Scheduler
DAILY_SEND_HOUR=8
DAILY_PROBLEM_COUNT=6

# Autonomous features (all enabled by default)
AUTO_SEED_ON_STARTUP=true
AUTO_SEED_MAX_PROBLEMS=500
FOLLOWUP_AFTER_HOURS=6
WEEKLY_REPORT_DAY=0
WEEKLY_REPORT_HOUR=9
SYNC_INTERVAL_HOURS=6
ENABLE_FOLLOWUPS=true
ENABLE_WEEKLY_REPORTS=true
ENABLE_STREAK_REMINDERS=true
